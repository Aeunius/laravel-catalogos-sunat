{
    "name": "aeunius/laravel-catalogos-sunat",
    "description": "Los catálogos de la SUNAT (Anexo N.° 8 de la facturación electrónica) como datos consultables: tipos de documento, monedas, unidades de medida, tributos, afectación del IGV, ubigeo, UNSPSC y el resto.",
    "keywords": [
        "laravel",
        "sunat",
        "peru",
        "facturacion-electronica",
        "catalogos",
        "ubl",
        "cpe"
    ],
    "homepage": "https://github.com/Aeunius/laravel-catalogos-sunat",
    "license": "MIT",
    "authors": [
        {
            "name": "Alejandro Gonzales",
            "homepage": "https://github.com/Aeunius"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Aeunius\\CatalogosSunat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aeunius\\CatalogosSunat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aeunius\\CatalogosSunat\\CatalogosSunatServiceProvider"
            ],
            "aliases": {
                "Catalogos": "Aeunius\\CatalogosSunat\\Facades\\Catalogos"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
